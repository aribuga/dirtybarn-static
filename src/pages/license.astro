---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="License"
  description="Standard License terms for Dirtybarn digital assets sold through Gumroad, plus guidance for extended uses."
  canonicalPath="/license/"
>
  <section class="store-shell license-hero">
    <p class="store-kicker">License</p>
    <div>
      <p class="license-status">Included with every Gumroad purchase</p>
      <h1>One clear Standard License.</h1>
      <p class="license-hero__copy">
        Products currently sold through Gumroad include the Standard License only.
        If your use needs a broader commercial scope, contact Dirtybarn before using
        the asset.
      </p>
    </div>
  </section>

  <section class="store-shell license-standard" aria-labelledby="standard-license-title">
    <header>
      <p class="store-kicker">Standard / Included</p>
      <h2 id="standard-license-title">For personal work and limited commercial use.</h2>
    </header>

    <div class="license-standard__summary">
      <p>
        Use the licensed asset without a royalty fee for non-paid, non-commercial work.
        For commercial work, one license covers up to 5,000 physical or digital end
        products for one client or one business.
      </p>
      <p>
        A separate license is required for each additional client or business. Each
        produced unit counts toward the 5,000-product limit.
      </p>
    </div>

    <div class="license-rules">
      <article>
        <p class="store-kicker">Included</p>
        <ul>
          <li>Royalty-free personal and non-commercial use</li>
          <li>Up to 5,000 physical or digital end products</li>
          <li>One end client or one business per license</li>
          <li>Business social media accounts</li>
          <li>Physical or digital paid advertisements</li>
        </ul>
      </article>

      <article class="license-rules__restricted">
        <p class="store-kicker">Not included</p>
        <ul>
          <li>Reselling or redistributing the source asset</li>
          <li>Use beyond 5,000 end products</li>
          <li>Use for additional clients without another license</li>
          <li>Software, websites or games</li>
          <li>Exclusive or unrestricted commercial rights</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="store-shell license-contact" aria-labelledby="license-contact-title">
    <p class="store-kicker">Need a broader license?</p>
    <div>
      <h2 id="license-contact-title">Tell us how you plan to use the asset.</h2>
      <p>
        For larger production volumes, software, website or game use, exclusive rights,
        or another use outside the Standard License, request a custom license directly
        from Dirtybarn.
      </p>
      <a
        class="button button--primary"
        href="mailto:hi@dirtybarn.com?subject=Extended%20license%20request"
      >Request a broader license ↗</a>
    </div>
  </section>

  <aside class="store-shell license-note">
    <p>
      Questions about a specific product or use? Email
      <a href="mailto:hi@dirtybarn.com">hi@dirtybarn.com</a> before publishing or distributing your work.
    </p>
  </aside>
</BaseLayout>
