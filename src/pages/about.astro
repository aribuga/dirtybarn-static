---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Dirtybarn is a design platform creating graphics, motion, mockups and digital assets for designers."
  canonicalPath="/about/"
  section="about"
>
  <section class="store-shell about-hero">
    <p class="store-kicker">About</p>
    <h1>From a small asset maker to a platform for the design community.</h1>
  </section>

  <section class="store-shell about-story" aria-labelledby="about-story-title">
    <p class="store-kicker">The brand</p>
    <div>
      <h2 id="about-story-title">Dirtybarn opened its barn doors in 2019.</h2>
      <p>
        It began by producing mockups and digital assets for designers. In 2021, that
        structure grew into a broader space for the design community.
      </p>
      <p>
        Today, Dirtybarn publishes stories and creates graphics, motion, mockups and
        assets that help designers make and present their work.
      </p>
    </div>
  </section>

  <section class="store-shell about-services" aria-labelledby="about-services-title">
    <div class="store-section-head">
      <div>
        <p class="store-kicker">Services</p>
        <h2 id="about-services-title">What we make</h2>
      </div>
      <a href="mailto:hi@dirtybarn.com">Work with us ↗</a>
    </div>
    <ul>
      <li>3D modelling</li>
      <li>3D design</li>
      <li>Graphic design</li>
      <li>Illustration</li>
      <li>Animation</li>
      <li>AR effects</li>
    </ul>
  </section>

  <section class="store-shell about-grid">
    <div>
      <h2>Asset library</h2>
      <p>Browse mockups, graphics, templates, effects and other downloadable tools made for design and image-making.</p>
      <p><a href="/#catalog">Browse assets ↗</a></p>
    </div>
    <div>
      <h2>Journal</h2>
      <p>Read artist features, interviews, process notes and practical guides published for the wider design community.</p>
      <p><a href="/blog/">Read the Journal ↗</a></p>
    </div>
    <div>
      <h2>Let’s work together</h2>
      <p>Like our products and aesthetics? We are open to creating unique design work for brands and collaborators.</p>
      <p><a href="mailto:hi@dirtybarn.com">hi@dirtybarn.com ↗</a></p>
    </div>
    <div>
      <h2>Product support</h2>
      <p>Questions about an asset, an existing purchase or its license can be sent through the contact page.</p>
      <p><a href="/contact/">Contact Dirtybarn ↗</a></p>
    </div>
  </section>
</BaseLayout>
