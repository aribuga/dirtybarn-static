<div class="store-overlay" id="site-search" hidden data-search-dialog>
  <button class="store-overlay__scrim" type="button" data-search-close aria-label="Close search"></button>
  <section
    class="store-search-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="site-search-title"
  >
    <div class="store-layer-head">
      <span id="site-search-title">Search Dirtybarn</span>
      <button class="icon-button" type="button" data-search-close aria-label="Close search">×</button>
    </div>
    <label class="visually-hidden" for="site-search-input">Search assets and journal articles</label>
    <input
      class="store-search-input"
      id="site-search-input"
      type="search"
      placeholder="Type to search…"
      autocomplete="off"
      data-search-input
    />
    <div class="store-search-results" data-search-results aria-live="polite"></div>
  </section>
</div>

<script>
  interface SearchItem {
    title: string;
    type: 'Asset' | 'Journal';
    url: string;
    search: string;
  }

  const layer = document.querySelector<HTMLElement>('[data-search-dialog]');
  const input = layer?.querySelector<HTMLInputElement>('[data-search-input]');
  const results = layer?.querySelector<HTMLElement>('[data-search-results]');
  const openButtons = document.querySelectorAll<HTMLButtonElement>('[data-search-open]');
  let items: SearchItem[] = [];
  let loadingPromise: Promise<SearchItem[]> | null = null;
  let previousFocus: HTMLElement | null = null;

  function loadItems() {
    loadingPromise ||= fetch('/search-index.json')
      .then((response) => {
        if (!response.ok) throw new Error('Search index unavailable');
        return response.json();
      })
      .then((value) => {
        items = Array.isArray(value) ? value : [];
        return items;
      })
      .catch(() => {
        items = [];
        return items;
      });
    return loadingPromise;
  }

  function renderResults() {
    if (!results || !input) return;
    const query = input.value.trim().toLocaleLowerCase('en');
    const matches = (query ? items.filter((item) => item.search.includes(query)) : items).slice(0, 12);
    results.replaceChildren();

    const label = document.createElement('span');
    label.className = 'store-search-results__label';
    label.textContent = query ? `${matches.length} result${matches.length === 1 ? '' : 's'}` : 'Latest assets and articles';
    results.append(label);

    if (!matches.length) {
      const empty = document.createElement('p');
      empty.className = 'store-search-results__empty';
      empty.textContent = query ? 'No matching assets or articles.' : 'Search is unavailable right now.';
      results.append(empty);
      return;
    }

    for (const item of matches) {
      const link = document.createElement('a');
      link.href = item.url;
      const title = document.createElement('span');
      title.textContent = item.title;
      const type = document.createElement('small');
      type.textContent = item.type;
      link.append(title, type);
      results.append(link);
    }
  }

  async function openSearch(trigger?: HTMLElement) {
    if (!layer || !input) return;
    previousFocus = trigger || (document.activeElement instanceof HTMLElement ? document.activeElement : null);
    layer.hidden = false;
    document.body.classList.add('is-layer-open');
    openButtons.forEach((button) => button.setAttribute('aria-expanded', 'true'));
    await loadItems();
    renderResults();
    requestAnimationFrame(() => input.focus());
  }

  function closeSearch() {
    if (!layer || layer.hidden) return;
    layer.hidden = true;
    document.body.classList.remove('is-layer-open');
    openButtons.forEach((button) => button.setAttribute('aria-expanded', 'false'));
    previousFocus?.focus();
  }

  openButtons.forEach((button) => button.addEventListener('click', () => openSearch(button)));
  layer?.querySelectorAll<HTMLElement>('[data-search-close]').forEach((button) =>
    button.addEventListener('click', closeSearch),
  );
  input?.addEventListener('input', renderResults);

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      openSearch();
      return;
    }
    if (event.key === 'Escape') closeSearch();
    if (event.key !== 'Tab' || !layer || layer.hidden) return;
    const focusable = [...layer.querySelectorAll<HTMLElement>('button, input, a[href]')].filter(
      (element) => !element.hasAttribute('disabled'),
    );
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>
